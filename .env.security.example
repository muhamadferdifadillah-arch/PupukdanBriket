# SECURITY BEST PRACTICES - Environment Configuration (.env)

# Set APP_DEBUG to false di production untuk tidak menampilkan error details
APP_DEBUG=false

# Set APP_ENV to production
APP_ENV=production

# HTTPS Configuration - Force HTTPS di production
APP_URL=https://yourdomain.com
FORCE_HTTPS=true

# Encryption Configuration - Generate key dengan: php artisan key:generate
APP_KEY=base64:YOUR_ENCRYPTION_KEY_HERE
APP_CIPHER=AES-256-CBC

# Database Configuration - Gunakan strong password
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pupukdan_briket
DB_USERNAME=db_user_secure
DB_PASSWORD=STRONG_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session Configuration
SESSION_DOMAIN=yourdomain.com
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY=15

# Logging Configuration
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_SECURITY_EVENTS=true

# Mail Configuration (untuk send email alerts)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_password

# API Configuration
API_RATE_LIMIT=100
API_RATE_LIMIT_MINUTES=1

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# File Upload Configuration
FILE_UPLOAD_MAX_SIZE=5242880
FILE_UPLOAD_ALLOWED_MIMES=jpg,jpeg,png,gif,pdf

# Security Headers
ENABLE_SECURITY_HEADERS=true

# Two Factor Authentication (optional, untuk future implementation)
TWO_FACTOR_ENABLED=false
